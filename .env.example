# ---------------------------------------------------------------------------
# KarmaLMS configuration. Copy to `.env` and fill in. Everything is 12-factor:
# no secrets ever live in code. `docker compose up` works with these defaults.
# ---------------------------------------------------------------------------

# --- Core ---
APP_URL=http://localhost:3000
DATABASE_URL=postgres://karmalms:karmalms@localhost:5432/karmalms

# --- Branding defaults (an org admin can override these in-app) ---
BRAND_NAME=KarmaLMS
BRAND_PRIMARY_COLOR=#6366f1
BRAND_LOGO_LIGHT=/logo.svg
BRAND_LOGO_DARK=/logo.svg
BRAND_BANNER_LIGHT=
BRAND_BANNER_DARK=
BRAND_SUPPORT_URL=

# --- Auth adapter: dev | oidc | trusted-jwt | saml ---
# 'dev' signs you in as a seeded user with no identity provider — local only.
AUTH_MODE=dev

# Signs the session cookie. Generate one: openssl rand -base64 32
SESSION_SECRET=dev-insecure-secret-change-me

# oidc mode (point at your AWS Cognito user pool, Okta, Azure AD, Auth0...)
# Register this redirect URI with the IdP: <APP_URL>/api/auth/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_ORG_SLUG=default
# Emails granted admin on first sign-in (comma-separated) — set at least one.
OIDC_ADMIN_EMAILS=

# trusted-jwt mode ("append to your portal session" — your portal is the IdP)
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

# --- Storage adapter (S3-compatible: AWS S3, MinIO, R2...) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=karmalms
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Leave keys blank in production to use the instance IAM role instead.

# --- LLM adapter: bedrock | openai | none ---
LLM_MODE=none

# bedrock mode (runs inside your own AWS account — data stays in your VPC)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# openai-compatible mode
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Scheduled jobs (certification lapse reminders) ---
# Bearer token your scheduler sends when POSTing /api/cron/*. Unset = disabled.
CRON_SECRET=
# Reminders are always logged; also POSTed here if set (email service, Slack…).
NOTIFICATIONS_WEBHOOK_URL=

# --- Directory sync (HRIS) — DIRECTORY_MODE: none | bamboohr ---
DIRECTORY_MODE=none
DIRECTORY_ORG_SLUG=default
# bamboohr mode — POST /api/cron/directory-sync (Bearer CRON_SECRET) to run it
BAMBOOHR_SUBDOMAIN=
BAMBOOHR_API_KEY=
